@page "/forgot-password"
@using ChatGPTTool.Services
@using System.ComponentModel.DataAnnotations
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Quên mật khẩu</PageTitle>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="login-card">
                <div class="text-center mb-4">
                    <h2>Quên mật khẩu?</h2>
                    <p class="text-muted">Nhập email của bạn để nhận link reset mật khẩu</p>
                </div>

                @if (!string.IsNullOrEmpty(message))
                {
                    <div class="alert @(isSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
                        @message
                        <button type="button" class="btn-close" @onclick="() => message = string.Empty"></button>
                    </div>
                }

                <EditForm Model="@forgotPasswordModel" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <InputText id="email" class="form-control" @bind-Value="forgotPasswordModel.Email" />
                        <ValidationMessage For="@(() => forgotPasswordModel.Email)" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mb-3" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Đang gửi...</span>
                        }
                        else
                        {
                            <span>Gửi link reset</span>
                        }
                    </button>

                    <div class="text-center">
                        <a href="/login" class="text-decoration-none">Quay lại đăng nhập</a>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private ForgotPasswordModel forgotPasswordModel = new();
    private string message = string.Empty;
    private bool isSuccess = false;
    private bool isLoading = false;

    private async Task HandleSubmit()
    {
        try
        {
            isLoading = true;
            message = string.Empty;

            var result = await AuthService.RequestPasswordResetAsync(forgotPasswordModel.Email);
            
            if (result)
            {
                isSuccess = true;
                message = "Link reset mật khẩu đã được gửi đến email của bạn. Vui lòng kiểm tra hộp thư.";
            }
            else
            {
                isSuccess = false;
                message = "Có lỗi xảy ra. Vui lòng thử lại sau.";
            }
        }
        catch (Exception ex)
        {
            isSuccess = false;
            message = $"Lỗi: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    public class ForgotPasswordModel
    {
        [Required(ErrorMessage = "Email là bắt buộc")]
        [EmailAddress(ErrorMessage = "Email không hợp lệ")]
        public string Email { get; set; } = string.Empty;
    }
}



















