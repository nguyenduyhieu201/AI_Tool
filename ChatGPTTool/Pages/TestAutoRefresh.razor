@page "/test-auto-refresh"
@using ChatGPTTool.Services
@inject ITestApiService TestApiService
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h4>🧪 Test Auto-Refresh Token</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <strong>Hướng dẫn test:</strong>
                        <ol>
                            <li>Đăng nhập bằng Google trước</li>
                            <li>Đợi 1 phút để JWT hết hạn</li>
                            <li>Click "Test API" - sẽ thấy auto-refresh hoạt động</li>
                        </ol>
                    </div>

                    <div class="mb-3">
                        <button class="btn btn-primary me-2" @onclick="TestApi">
                            🚀 Test API (Protected Endpoint)
                        </button>
                        <button class="btn btn-secondary" @onclick="TestUserProfile">
                            👤 Test User Profile
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(result))
                    {
                        <div class="alert @(result.StartsWith("Success") ? "alert-success" : "alert-danger")">
                            <strong>Kết quả:</strong><br />
                            <pre>@result</pre>
                        </div>
                    }

                    <div class="mt-3">
                        <h6>Token Status:</h6>
                        <ul>
                            <li>Access Token: @tokenStatus</li>
                            <li>Refresh Token: @refreshTokenStatus</li>
                        </ul>
                    </div>

                    <div class="mt-3">
                        <a href="/" class="btn btn-outline-primary">← Về trang chủ</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string result = "";
    private string tokenStatus = "";
    private string refreshTokenStatus = "";

    protected override async Task OnInitializedAsync()
    {
        var isAuthenticated = await AuthService.IsAuthenticatedAsync();
        if (!isAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }
        
        // Load initial token status
        await LoadTokenStatus();
    }

    private async Task TestApi()
    {
        result = await TestApiService.TestProtectedEndpointAsync();
        await LoadTokenStatus(); // Refresh token status after API call
        StateHasChanged();
    }

    private async Task TestUserProfile()
    {
        result = await TestApiService.TestUserProfileAsync();
        await LoadTokenStatus(); // Refresh token status after API call
        StateHasChanged();
    }

    private async Task<string> GetTokenStatus()
    {
        var token = await AuthService.GetTokenAsync();
        if (string.IsNullOrEmpty(token))
            return "❌ Không có";
        
        try
        {
            var handler = new System.IdentityModel.Tokens.Jwt.JwtSecurityTokenHandler();
            var jwtToken = handler.ReadJwtToken(token);
            var expiresAt = jwtToken.ValidTo;
            var isExpired = expiresAt < DateTime.UtcNow;
            
            return isExpired ? $"❌ Hết hạn ({expiresAt:HH:mm:ss})" : $"✅ Còn hiệu lực ({expiresAt:HH:mm:ss})";
        }
        catch
        {
            return "❌ Invalid token";
        }
    }

    private async Task<string> GetRefreshTokenStatus()
    {
        var refreshToken = await AuthService.GetRefreshTokenAsync();
        return string.IsNullOrEmpty(refreshToken) ? "❌ Không có" : "✅ Có";
    }

    private async Task LoadTokenStatus()
    {
        tokenStatus = await GetTokenStatus();
        refreshTokenStatus = await GetRefreshTokenStatus();
    }
}


