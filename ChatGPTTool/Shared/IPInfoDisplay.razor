@using ChatGPTTool.Services
@inject IIPService IPService

<div class="ip-info-display">
    @if (isLoading)
    {
        <div class="text-muted small">
            <i class="oi oi-reload spin"></i> Đang lấy thông tin IP...
        </div>
    }
    else if (!string.IsNullOrEmpty(clientIP))
    {
        <div class="card border-info">
            <div class="card-header bg-info text-white">
                <i class="oi oi-monitor"></i> Thông tin kết nối
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <strong>IP Address:</strong> @clientIP
                    </div>
                    <div class="col-md-6">
                        <strong>Location:</strong> @ipLocation
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(isp))
                {
                    <div class="mt-2">
                        <small class="text-muted">
                            <strong>ISP:</strong> @isp<br />
                            <strong>Timezone:</strong> @timezone
                        </small>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <i class="oi oi-warning"></i> Không thể lấy thông tin IP
        </div>
    }
</div>

@code {
    private string? clientIP;
    private string? ipLocation;
    private string? isp;
    private string? timezone;
    private bool isLoading = true;

    // ✅ SỬA: Sử dụng OnAfterRenderAsync
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await GetIPInfo();
            StateHasChanged();
        }
    }

    private async Task GetIPInfo()
    {
        try
        {
            isLoading = true;

            var clientInfo = await IPService.GetClientInfoAsync();
            clientIP = clientInfo.IP;

            if (clientInfo.IPInfo != null)
            {
                ipLocation = $"{clientInfo.IPInfo.City}, {clientInfo.IPInfo.Country}";
                isp = clientInfo.IPInfo.ISP;
                timezone = clientInfo.IPInfo.Timezone;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error getting IP info: {ex.Message}");
            clientIP = "unknown";
        }
        finally
        {
            isLoading = false;
        }
    }
}

<style>
    .spin {
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        from

    {
        transform: rotate(0deg);
    }

    to {
        transform: rotate(360deg);
    }

    }

    .ip-info-display {
        margin: 10px 0;
    }
</style>