@using ChatGPTTool.Services
@inject IAuthService AuthService

@if (currentUser != null)
{
    <div class="user-profile">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <span class="oi oi-person" aria-hidden="true"></span>
                    Thông tin cá nhân
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-3">
                        <h6 class="mb-0">ID:</h6>
                    </div>
                    <div class="col-sm-9 text-secondary">
                        @currentUser.Id
                    </div>
                </div>
                <hr>
                <div class="row">
                    <div class="col-sm-3">
                        <h6 class="mb-0">Email:</h6>
                    </div>
                    <div class="col-sm-9 text-secondary">
                        @currentUser.Email
                    </div>
                </div>
                <hr>
                <div class="row">
                    <div class="col-sm-3">
                        <h6 class="mb-0">Tên:</h6>
                    </div>
                    <div class="col-sm-9 text-secondary">
                        @(string.IsNullOrEmpty(currentUser.Name) ? "Chưa cập nhật" : currentUser.Name)
                    </div>
                </div>
                <hr>
                <div class="row">
                    <div class="col-sm-3">
                        <h6 class="mb-0">Vai trò:</h6>
                    </div>
                    <div class="col-sm-9 text-secondary">
                        @(string.IsNullOrEmpty(currentUser.Role) ? "User" : currentUser.Role)
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">
        <span class="oi oi-warning" aria-hidden="true"></span>
        Không thể tải thông tin người dùng
    </div>
}

@code {
    [Parameter] public UserInfo? currentUser { get; set; }
}

