<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChatGPTUI.LoginPage">
    <VerticalStackLayout Padding="30" Spacing="15">
        <Label Text="Đăng nhập" FontSize="24" HorizontalOptions="Center"/>
        <Entry x:Name="EmailEntry" Placeholder="Email"/>
        <Entry x:Name="PasswordEntry" Placeholder="Mật khẩu" IsPassword="True"/>
        <Button Text="Đăng nhập" Clicked="OnLoginClicked"/>
        <Button Text="Đăng nhập với Google" Clicked="OnGoogleLoginClicked"/>
        <Label x:Name="MessageLabel" TextColor="Red"/>
    </VerticalStackLayout>
</ContentPage> 