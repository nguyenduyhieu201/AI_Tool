# Production Environment Variables for AITool
# Copy this file to .env.prod and update the values

# Database Configuration
SA_PASSWORD=YourStrongPassword123!
DB_NAME=AIToolDb

# Redis Configuration
REDIS_PASSWORD=YourRedisPassword123!

# MongoDB Configuration
MONGO_DATABASE=chatgpt_service

# RabbitMQ Configuration
RABBITMQ_USER=aitool_user
RABBITMQ_PASS=YourRabbitMQPassword123!

# Application Configuration
ASPNETCORE_ENVIRONMENT=Production

# Security
JWT_SECRET_KEY=YourSuperSecretJWTKey12345678901234567890
ENCRYPTION_KEY=YourEncryptionKey123456789012345678901234567890

# External Services
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Monitoring
LOG_LEVEL=Information
ENABLE_SWAGGER=false

# SSL Configuration (if using HTTPS)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
